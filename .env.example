# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=yms
POSTGRES_USER=yms
POSTGRES_PASSWORD=change_me_in_production

# ── API server ────────────────────────────────────────────────────────────────
# Must be a long random string. Generate one with:
#   openssl rand -hex 32
SESSION_SECRET=change_me_in_production

# ── Web (optional) ────────────────────────────────────────────────────────────
# Host port nginx listens on. Defaults to 80.
# WEB_PORT=80

# ── OpenAI — optional ─────────────────────────────────────────────────────────
# Leave unset to run without AI features (app degrades gracefully).
# Enables: email intelligence, move recommendations, Assist/Optimize modes.
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
